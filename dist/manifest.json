{
  "manifest_version": 3,
  "name": "Jira Timekeeper",
  "description": "Log your day across Jira issues in one focused workflow.",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open Jira Timekeeper",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "permissions": ["storage", "sidePanel", "alarms"],
  "optional_host_permissions": ["https://*/*"]
}
